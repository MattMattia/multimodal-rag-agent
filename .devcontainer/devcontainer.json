{
  "name": "Multimodal RAG & Agent (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "containerEnv": {
    "DATABASE_URL": "sqlite+aiosqlite:///./rag_standalone.db",
    "FASTAPI_URL": "http://localhost:8000"
  },
  "postCreateCommand": "pip install -r requirements.txt && pip install -r frontend/requirements.txt && cd web && npm ci",
  "forwardPorts": [8000, 8501, 3001],
  "portsAttributes": {
    "8000": { "label": "FastAPI (python run.py)", "onAutoForward": "notify" },
    "8501": { "label": "Streamlit (streamlit run frontend/app.py)", "onAutoForward": "silent" },
    "3001": { "label": "Next.js web (cd web && npm run dev)", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint"]
    }
  }
}
