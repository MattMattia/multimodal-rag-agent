# ==============================================================================
# CONFIGURACIÓN GENERAL
# ==============================================================================
PROJECT_NAME="Sistema RAG Multimodal & Agente IA Autónomo"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# ==============================================================================
# BASE DE DATOS (PostgreSQL 16 + pgvector / Auto-Fallback SQLite Zero-Docker)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_multimodal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_multimodal
AUTO_FALLBACK_SQLITE=True
AUTO_SEED_DEMO_CORPUS=True

# ==============================================================================
# GOOGLE AI (Gemini & Embeddings)
# ==============================================================================
GOOGLE_API_KEY=tu_google_api_key_aqui
GEMINI_AGENT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=50

# ==============================================================================
# INGESTA, BÚSQUEDA HÍBRIDA Y AGENTE REACT
# ==============================================================================
PARENT_CHUNK_SIZE=1200
PARENT_CHUNK_OVERLAP=120
CHILD_CHUNK_SIZE=350
CHILD_CHUNK_OVERLAP=40
PDF_IMAGE_DPI=150
PDF_MIN_IMAGE_DIM=40
SEARCH_CANDIDATE_MULTIPLIER=4
RRF_K=60
RERANK_TIMEOUT_SECONDS=8.0
RERANK_MAX_SNIPPET_CHARS=800
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_TURNS=4
AGENT_TEMPERATURE=0.2

# ==============================================================================
# SEGURIDAD, RATE LIMITING Y CORS
# ==============================================================================
API_KEY=
ALLOWED_WEBHOOK_HOSTS=[]
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:8000", "http://localhost:8501"]
ALLOWED_ORIGIN_REGEX=

# ==============================================================================
# OBSERVABILIDAD Y TELEMETRÍA (Langfuse)
# ==============================================================================
LANGFUSE_PUBLIC_KEY="pk-lf-tu-clave-publica"
LANGFUSE_SECRET_KEY="sk-lf-tu-clave-secreta"
LANGFUSE_HOST="http://localhost:3000"
LANGFUSE_ENABLED=false
