# ==============================================================================
# CONFIGURACIÓN GENERAL
# ==============================================================================
PROJECT_NAME="Sistema RAG Multimodal & Agente IA Autónomo"
ENVIRONMENT="development"
DEBUG=True

# ==============================================================================
# BASE DE DATOS (PostgreSQL 16 + pgvector)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_multimodal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_multimodal

# ==============================================================================
# GOOGLE AI (Gemini 1.5 & Embeddings)
# ==============================================================================
GOOGLE_API_KEY=tu_google_api_key_aqui
GEMINI_AGENT_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-flash

# ==============================================================================
# SEGURIDAD Y CORS
# ==============================================================================
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost:8501"]

