# Server-only settings for the Next.js BFF (never prefix them with NEXT_PUBLIC_).
# Base URL of the FastAPI backend (without /api/v1). Leave empty to always use the showcase engine.
FASTAPI_URL=http://localhost:8000
# Must match the backend API_KEY when it is set; sent as the X-API-Key header from the server only.
API_KEY=
# Optional: milliseconds to wait for the backend response headers before falling back (default 3000).
FASTAPI_TIMEOUT_MS=3000
